# Copy to .env.local. Everything is optional locally: the app runs on PGlite,
# a test checkout and a dev mailbox until you fill these in.

# Public URL, used in emails, share links and Stripe redirects.
SITE_URL=http://localhost:3007

# Signs short-lived tokens (test checkout). Any long random string in production.
APP_SECRET=

# Hosted Postgres. Leave empty to use the local PGlite database in .data/pglite.
DATABASE_URL=

# Stripe. With a secret key set, checkout goes to Stripe and the test checkout turns off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live products and the save-offer coupon in the "ghostly" Stripe account (IDs are not secret).
STRIPE_PRODUCT_WEEKLY=
STRIPE_PRODUCT_MONTHLY=
STRIPE_PRODUCT_LIFETIME=
STRIPE_PRODUCT_FIRST_WEEK=
STRIPE_COUPON_SAVE50=

# Resend for email. Without it, emails land in /dev/mail.
RESEND_API_KEY=
EMAIL_FROM="Ghostless <hello@ghostless.co>"
# Outside production, send every email here instead of to the real recipient.
EMAIL_TEST_REDIRECT=

# Bearer token for /api/cron/* (Vercel Cron sends it). Locally defaults to dev-cron-secret.
CRON_SECRET=

# /admin/enter?token=<this>. Locally defaults to dev-admin.
ADMIN_TOKEN=
